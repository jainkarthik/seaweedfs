#!/bin/bash
set -e

case "$1" in
    configure)
        # Create system user if it doesn't exist
        if ! id weed &>/dev/null; then
            useradd --system --no-create-home --shell /usr/sbin/nologin weed || true
        fi

        # Create required directories
        mkdir -p /opt/weed
        mkdir -p /var/log/weed
        mkdir -p /run/weed

        # Set ownership
        chown -R weed:weed /opt/weed /var/log/weed /run/weed 2>/dev/null || true

        # Ensure binary is executable
        if [ -f /opt/weed/weed ]; then
            chmod 0755 /opt/weed/weed
        fi

        # Copy example configs if they don't exist
        if [ ! -f /etc/weed/master.toml ]; then
            cp /etc/weed/examples/master-1.toml /etc/weed/master.toml 2>/dev/null || true
        fi
        if [ ! -f /etc/weed/volume.toml ]; then
            cp /etc/weed/examples/volume-1.toml /etc/weed/volume.toml 2>/dev/null || true
        fi
        if [ ! -f /etc/weed/filer.toml ]; then
            cp /etc/weed/examples/filer-1.toml /etc/weed/filer.toml 2>/dev/null || true
        fi

        # Reload systemd to detect new service files
        if command -v systemctl &>/dev/null; then
            systemctl daemon-reload 2>/dev/null || true
        fi

        echo ""
        echo "=============================================="
        echo "SeaweedFS installed successfully!"
        echo ""
        echo "Next steps:"
        echo "1. Edit configuration files in /etc/weed/"
        echo "2. Enable and start services:"
        echo ""
        echo "   Master:    sudo systemctl enable --now weed-master@1"
        echo "   Volume:    sudo systemctl enable --now weed-volume@1"
        echo "   Filer:     sudo systemctl enable --now weed-filer@1"
        echo "   S3 API:    sudo systemctl enable --now weed-s3@1"
        echo ""
        echo "For multiple instances, use @2, @3, etc."
        echo "=============================================="
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        exit 0
        ;;

    *)
        exit 0
        ;;
esac



exit 0
